{
  "name": "dsh-suggest-next-prompt",
  "version": "0.1.0",
  "description": "DSH web plugin: a model-generated next prompt in the chat composer placeholder, pasted with Tab and cycled with the arrow keys.",
  "type": "module",
  "license": "MIT",
  "author": "DIV7NE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "composer",
    "prompt",
    "copilot"
  ],
  "homepage": "https://github.com/DIV7NE/dshpluginsdev/tree/main/dsh-suggest-next-prompt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DIV7NE/dshpluginsdev.git",
    "directory": "dsh-suggest-next-prompt"
  },
  "bugs": {
    "url": "https://github.com/DIV7NE/dshpluginsdev/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
