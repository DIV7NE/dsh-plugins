{
  "name": "dsh-chrome-agent",
  "version": "0.1.0",
  "description": "DSH plugin: drive your real, logged-in Chrome through a pinned companion extension (chrome.debugger / CDP) instead of a separate browser profile.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "extension/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs && node test/probe-eval-contract.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "pack:webstore": "node scripts/pack-webstore.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "author": "DIV7NE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "chrome",
    "cdp",
    "browser-automation"
  ],
  "homepage": "https://github.com/DIV7NE/dsh-plugins/tree/main/dsh-chrome-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DIV7NE/dsh-plugins.git",
    "directory": "dsh-chrome-agent"
  },
  "bugs": {
    "url": "https://github.com/DIV7NE/dsh-plugins/issues"
  }
}
